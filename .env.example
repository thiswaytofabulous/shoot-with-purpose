# Copy to .env for local `netlify dev`, or set these in
# Netlify -> Site configuration -> Environment variables for production.

# Required. Never commit this.
ANTHROPIC_API_KEY=

# Required for email (resume links, the client's PDF, your brief).
RESEND_API_KEY=
# Sending address on your verified Resend domain (name is added per brand).
FROM_EMAIL_ADDRESS=noreply@havenbuiltmedia.com
# Where your strategy briefs go.
BRIEF_TO_EMAIL=jessi@thiswaytofabulous.com
# Optional: where client replies go (defaults to BRIEF_TO_EMAIL on the PDF email).
REPLY_TO_EMAIL=

# Required for /admin.html — any long random string only you know.
ADMIN_TOKEN=

# Optional: override the model.
MODEL=claude-sonnet-5
